[Unit]
Description=Daily exchange-rate snapshot for tools.timeminer.cc (17:00 Asia/Shanghai)

[Timer]
# The host runs on Europe/Berlin, but the refresh window is defined in Beijing
# time, so the schedule pins the zone explicitly instead of using the host clock.
OnCalendar=*-*-* 17:00:00 Asia/Shanghai
Persistent=true
RandomizedDelaySec=5m
Unit=timeminer-tools-snapshot.service

[Install]
WantedBy=timers.target
